<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<#
    var colors = new string[] { "Cherry", "Tomato", "Orange", "Pineapple", "Apple", "Kiwi", "Kale", "Blueberry", "Plum", "Elderberry", "Blackberry", "Raspberry" };
    var milks = new string[] { "None", "Splash", "Glug", "Cup" };
    var modes = new string[] { "Dark", "Dark Soft", "Light Soft", "Light" };


    var schemes = new List<(int Sugar, int Colors, int Sogginess, string Flavor, string Fruit, string Milk, string Name, string Display, string Mode)>();

    schemes.Add((7, 10, 10,  "Classic", "Elderberry", "Splash", "RetroBlue", "Retro Blue", "Blue"));

    foreach (var color in colors)
    {
        for (int i = 0; i < milks.Length; i++)
        {
            var milk = milks[i];
            var mode = modes[i];

            schemes.Add((6, 8, 4, "Intense", color, milk, $"{color}{mode.Replace(" ", "")}", $"{color} {mode}", mode));
        }
    }
#>
