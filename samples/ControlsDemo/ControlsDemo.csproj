<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\\DemoTool.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>XenoAtom.Terminal.UI.ControlsDemo</PackageId>
    <ToolCommandName>xenoatom-controls-demo</ToolCommandName>
    <Description>Catalog demo for XenoAtom.Terminal.UI controls, themes, and interactions.</Description>
    <PackageTags>terminal;ui;demo;controls</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI\XenoAtom.Terminal.UI.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Graphics\XenoAtom.Terminal.UI.Graphics.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Extensions.CodeEditor.TextMateSharp\XenoAtom.Terminal.UI.Extensions.CodeEditor.TextMateSharp.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Extensions.Markdown\XenoAtom.Terminal.UI.Extensions.Markdown.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Extensions.Screenshot\XenoAtom.Terminal.UI.Extensions.Screenshot.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.SourceGen\XenoAtom.Terminal.UI.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="XenoAtom.Ansi" Version="1.7.0" />
    <PackageReference Include="XenoAtom.Terminal" Version="2.2.0" />
    <PackageReference Include="XenoAtom.Terminal.Graphics" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\markdown\markdown-control-sample.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\snow_photo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
