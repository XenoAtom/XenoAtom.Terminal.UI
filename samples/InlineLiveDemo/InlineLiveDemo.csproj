<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\\DemoTool.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>XenoAtom.Terminal.UI.InlineLiveDemo</PackageId>
    <ToolCommandName>xenoatom-inline-live-demo</ToolCommandName>
    <Description>Inline live regions demo for XenoAtom.Terminal.UI.</Description>
    <PackageTags>terminal;ui;demo;live</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI\XenoAtom.Terminal.UI.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Graphics\XenoAtom.Terminal.UI.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XenoAtom.Terminal" Version="2.2.0" />
    <PackageReference Include="XenoAtom.Terminal.Graphics" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\ControlsDemo\Assets\snow_photo.jpg" Link="Assets\snow_photo.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
