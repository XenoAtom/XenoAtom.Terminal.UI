<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\\DemoTool.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>XenoAtom.Terminal.UI.FullscreenDemo</PackageId>
    <ToolCommandName>xenoatom-fullscreen-demo</ToolCommandName>
    <Description>Fullscreen demo dashboard for XenoAtom.Terminal.UI.</Description>
    <PackageTags>terminal;ui;demo;fullscreen</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI\XenoAtom.Terminal.UI.csproj" />
    <ProjectReference Include="..\..\src\XenoAtom.Terminal.UI.Extensions.Screenshot\XenoAtom.Terminal.UI.Extensions.Screenshot.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="XenoAtom.Terminal" Version="2.2.0" />
  </ItemGroup>
</Project>
