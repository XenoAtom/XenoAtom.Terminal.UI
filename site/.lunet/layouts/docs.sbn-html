---
layout: base
---
<div class="container">
  {{~
    url = page.url ?? ""
    menu_key = "doc"
    if url | string.starts_with "/docs/controls"
      menu_key = "controls"
    else if url | string.starts_with "/docs/specs"
      menu_key = "specs"
      if url | string.starts_with "/docs/specs/controls"
        menu_key = "specs_controls"
      else if url | string.starts_with "/docs/specs/archive"
        menu_key = "specs_archive"
      end
    end
    menu = site.menu[menu_key] ?? site.menu.doc
  ~}}
  <div class="row">
      <div id="docsSidebar" class="col col-lg-2 align-self-start sticky-top menu-sidebar collapse d-lg-block">
        {{ menu.render { kind: "menu",  collapsible: true } }}
      </div>
      <div class="col col-xxl-8 js-toc-content">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">Home</a></li>
          {{~ if url | string.starts_with "/docs" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/">Docs</a></li>
            {{~ if url | string.starts_with "/docs/controls" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/controls/">Controls</a></li>
            {{~ else if url | string.starts_with "/docs/specs" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/specs/">Specs</a></li>
            {{~ end ~}}
          {{~ end ~}}
          <li class="breadcrumb-item active">{{ page.title }}</li>
        </ol>
        <p id="lunet-results"></p>
        <!-- Toggle button visible only on small screens -->
        <button
          class="btn btn-outline-secondary btn-sm d-lg-none mb-3"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#docsSidebar"
          aria-controls="docsSidebar"
          aria-expanded="false"
          aria-label="Toggle docs menu">
          Table of Contents
        </button>
<!-- lunet:summarize -->
{{ content }}
      </div>
      <div id="docsSidebar" class="col col-lg-2 align-self-start sticky-top menu-sidebar collapse d-lg-block js-toc-content">
        <h3 class="toc-title">On this page</h3>
        <nav class="js-toc"></nav>
      </div>
  </div>
</div>
