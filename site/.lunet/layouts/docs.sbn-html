---
layout: base
---
<div class="container-xxl">
  {{~
    url = page.url ?? ""
    menu_key = "doc"
    if url | string.starts_with "/docs/controls"
      menu_key = "controls"
    else if url | string.starts_with "/docs/specs"
      menu_key = "specs"
      if url | string.starts_with "/docs/specs/controls"
        menu_key = "specs_controls"
      else if url | string.starts_with "/docs/specs/archive"
        menu_key = "specs_archive"
      end
    end
    menu = site.menu[menu_key] ?? site.menu.doc
  ~}}
  <div class="row">
      <!-- Left sidebar - responsive offcanvas (offcanvas on mobile, visible sidebar on md+) -->
      <nav id="docs-sidebar-menu" class="col-md-3 col-xxl-2 offcanvas-md offcanvas-start sticky-md-top menu-sidebar align-self-start order-1 order-md-0" tabindex="-1" aria-labelledby="docs-sidebar-menu-label">
        <div class="offcanvas-header">
          <h5 class="offcanvas-title" id="docs-sidebar-menu-label">Menu</h5>
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#docs-sidebar-menu" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
          {{ menu.render { kind: "menu",  collapsible: true } }}
        </div>
      </nav>
      <!-- Right sidebar (TOC) - collapsible on mobile, visible sidebar on xxl+ -->
      <aside id="docs-sidebar-toc" class="col-12 col-xxl-2 sticky-xxl-top menu-sidebar align-self-start order-0 order-xxl-2 collapse d-xxl-block">
        <h3 class="toc-title">On this page</h3>
        <nav class="js-toc"></nav>
      </aside>
      <!-- Main content column -->
      <div class="col-12 col-md-9 col-xxl-8 order-2 order-md-1 js-toc-content">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/">Home</a></li>
          {{~ if url | string.starts_with "/docs" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/">Docs</a></li>
            {{~ if url | string.starts_with "/docs/controls" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/controls/">Controls</a></li>
            {{~ else if url | string.starts_with "/docs/specs" ~}}
          <li class="breadcrumb-item"><a class="breadcrumb-link" href="/docs/specs/">Specs</a></li>
            {{~ end ~}}
          {{~ end ~}}
          <li class="breadcrumb-item active">{{ page.title }}</li>
        </ol>
        <p id="lunet-results"></p>
        <!-- Toggle buttons visible only on small screens -->
        <div class="d-md-none mb-3">
          <button
            class="btn btn-outline-secondary btn-sm me-2"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#docs-sidebar-menu"
            aria-controls="docs-sidebar-menu"
            aria-label="Toggle docs menu">
            Menu
          </button>
          <button
            class="btn btn-outline-secondary btn-sm d-xxl-none"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#docs-sidebar-toc"
            aria-controls="docs-sidebar-toc"
            aria-expanded="false"
            aria-label="Toggle Table Of Contents">
            On this page
          </button>
        </div>
<!-- lunet:summarize -->
{{ content }}
      </div>
  </div>
</div>
